      "size": 14.623952865600586,
      "flags": 20,
      "color": 0,
      "is_bold": false,
      "is_italic": false
    }
  },
  {
    "type": "text",
    "content": "Which solution will meet these requirements with the LEAST operational overhead?",
    "page_number": 15,
    "bbox": [
      57.8267707824707,
      165.5251922607422,
      432.00787353515625,
      180.24118041992188
